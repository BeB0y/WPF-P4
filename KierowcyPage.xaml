<Page x:Class="EwidencjaPrzejazdowWPF.Pages.KierowcyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="KierowcyPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Kierowcy" FontSize="24" FontWeight="Bold" Margin="5"/>
            <WrapPanel>
                <TextBox x:Name="ImieTextBox" Width="160"/>
                <TextBox x:Name="NazwiskoTextBox" Width="180"/>
                <TextBox x:Name="DzialTextBox" Width="180"/>
                <TextBox x:Name="StanowiskoTextBox" Width="180"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Dodaj" Click="AddButton_Click"/>
                <Button Content="Usuń zaznaczony" Click="DeleteButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Odśwież" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="KierowcyGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdKierowcy}" Width="80"/>
                <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="150"/>
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="180"/>
                <DataGridTextColumn Header="Dział" Binding="{Binding Dzial}" Width="180"/>
                <DataGridTextColumn Header="Stanowisko" Binding="{Binding Stanowisko}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
