<Page x:Class="EwidencjaPrzejazdowWPF.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HomePage">
    <Grid Margin="20">
        <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="8" Padding="25">
            <StackPanel>
                <TextBlock Text="System ewidencji przejazdów"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Gotowy projekt WPF do obsługi kierowców, pojazdów, przejazdów, kosztów i praw jazdy."
                           FontSize="16"
                           Margin="0,0,0,12"/>
                <TextBlock Text="Po lewej stronie wybierz moduł aplikacji."
                           FontSize="15"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
