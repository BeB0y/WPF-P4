<Page x:Class="EwidencjaPrzejazdowWPF.Pages.KosztyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="KosztyPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Koszty" FontSize="24" FontWeight="Bold" Margin="5"/>
            <WrapPanel>
                <ComboBox x:Name="RodzajKosztuComboBox" Width="160">
                    <ComboBoxItem Content="paliwo"/>
                    <ComboBoxItem Content="parking"/>
                    <ComboBoxItem Content="opłata drogowa"/>
                    <ComboBoxItem Content="inny"/>
                </ComboBox>
                <TextBox x:Name="KwotaTextBox" Width="120"/>
                <DatePicker x:Name="DataKosztuDatePicker" Width="140"/>
                <TextBox x:Name="OpisTextBox" Width="220"/>
                <ComboBox x:Name="PrzejazdComboBox" Width="120" DisplayMemberPath="IdPrzejazdu" SelectedValuePath="IdPrzejazdu"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Dodaj" Click="AddButton_Click"/>
                <Button Content="Usuń zaznaczony" Click="DeleteButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Odśwież" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="KosztyGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdKosztu}" Width="70"/>
                <DataGridTextColumn Header="Rodzaj" Binding="{Binding RodzajKosztu}" Width="150"/>
                <DataGridTextColumn Header="Kwota" Binding="{Binding Kwota}" Width="90"/>
                <DataGridTextColumn Header="Data" Binding="{Binding DataKosztu, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="240"/>
                <DataGridTextColumn Header="ID przejazdu" Binding="{Binding IdPrzejazdu}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
