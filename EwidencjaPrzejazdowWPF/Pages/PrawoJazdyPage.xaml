<Page x:Class="EwidencjaPrzejazdowWPF.Pages.PrawoJazdyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PrawoJazdyPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Prawa jazdy" FontSize="24" FontWeight="Bold" Margin="5"/>
            <WrapPanel>
                <TextBox x:Name="NumerTextBox" Width="180"/>
                <DatePicker x:Name="DataWydaniaDatePicker" Width="140"/>
                <DatePicker x:Name="DataWaznosciDatePicker" Width="140"/>
                <ComboBox x:Name="KierowcaComboBox" Width="220" DisplayMemberPath="WyswietlanaNazwa" SelectedValuePath="IdKierowcy"/>
                <ComboBox x:Name="KategoriaComboBox" Width="160" DisplayMemberPath="NazwaKategorii" SelectedValuePath="IdKategorii"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Dodaj" Click="AddButton_Click"/>
                <Button Content="Usuń zaznaczony" Click="DeleteButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Odśwież" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="PrawoJazdyGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdPrawaJazdy}" Width="70"/>
                <DataGridTextColumn Header="Numer" Binding="{Binding NumerPrawaJazdy}" Width="180"/>
                <DataGridTextColumn Header="Data wydania" Binding="{Binding DataWydania, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Data ważności" Binding="{Binding DataWaznosci, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="ID kierowcy" Binding="{Binding IdKierowcy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
