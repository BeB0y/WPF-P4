<Page x:Class="EwidencjaPrzejazdowWPF.Pages.PojazdyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PojazdyPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Pojazdy" FontSize="24" FontWeight="Bold" Margin="5"/>
            <WrapPanel>
                <TextBox x:Name="MarkaTextBox" Width="120"/>
                <TextBox x:Name="ModelTextBox" Width="120"/>
                <TextBox x:Name="RejestracjaTextBox" Width="140"/>
                <ComboBox x:Name="TypWlasnosciComboBox" Width="120">
                    <ComboBoxItem Content="służbowy"/>
                    <ComboBoxItem Content="prywatny"/>
                </ComboBox>
                <ComboBox x:Name="RodzajPaliwaComboBox" Width="120">
                    <ComboBoxItem Content="benzyna"/>
                    <ComboBoxItem Content="diesel"/>
                    <ComboBoxItem Content="LPG"/>
                    <ComboBoxItem Content="hybryda"/>
                    <ComboBoxItem Content="elektryczny"/>
                </ComboBox>
                <TextBox x:Name="SpalanieTextBox" Width="100"/>
                <TextBox x:Name="CenaPaliwaTextBox" Width="100"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Dodaj" Click="AddButton_Click"/>
                <Button Content="Usuń zaznaczony" Click="DeleteButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Odśwież" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="PojazdyGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdPojazdu}" Width="70"/>
                <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="120"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/>
                <DataGridTextColumn Header="Rejestracja" Binding="{Binding NumerRejestracyjny}" Width="140"/>
                <DataGridTextColumn Header="Własność" Binding="{Binding TypWlasnosci}" Width="110"/>
                <DataGridTextColumn Header="Paliwo" Binding="{Binding RodzajPaliwa}" Width="110"/>
                <DataGridTextColumn Header="Spalanie" Binding="{Binding SrednieSpalanie100km}" Width="100"/>
                <DataGridTextColumn Header="Cena paliwa" Binding="{Binding CenaPaliwaZaLitr}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
